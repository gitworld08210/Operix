# Dependencies (reinstalled inside the image via npm ci)
node_modules
.pnp
.pnp.js

# Build output (regenerated by `npm run build` inside the image)
.next
out
build

# Version control & CI
.git
.gitignore
.github

# Environment files — never bake secrets into the image
.env
.env*.local
.env.example

# Agent / task metadata
.agents
.kiro

# Editor / OS cruft
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docs & tests not needed at runtime
DEPLOYMENT.md
README.md
coverage
*.tsbuildinfo
