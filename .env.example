# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit real secrets.

# Azure Configuration
AZURE_STORAGE_CONNECTION_STRING=your_azure_storage_connection_string
AZURE_STORAGE_ACCOUNT_NAME=your_storage_account_name
AZURE_STORAGE_CONTAINER=ott-content

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Database
MONGODB_URI=your_mongodb_connection_string

# Authentication
# Secret used to HMAC-sign the session cookie (`ott_session`). REQUIRED for any
# login to work: registration, user login and admin login all fail closed
# (HTTP 401/500) when this is unset, and it is never given a default because a
# predictable key would let anyone forge an admin session. Generate a strong
# random value, e.g. `openssl rand -base64 32`. Rotating it invalidates all
# existing sessions (every user is signed out).
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3000

# Built-in administrator credentials. The admin signs in SEPARATELY from normal
# users at /admin/login using these values; a matching pair mints a session
# cookie with role="admin" that unlocks the admin panel and the write/upload
# APIs. Both must be set — the admin login route fails closed (HTTP 401) when
# either is missing. Use a strong, unique password and never reuse a normal
# user's credentials here.
# An admin stored in MongoDB (a User document with role="admin") is also
# supported and can sign in through the normal /login route instead.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_to_a_strong_password

# Shared secret gating the movie write endpoints (POST/PUT/DELETE /api/movies)
# and the upload routes. Sent by admin callers in the `x-admin-token` header;
# retained for scripts/CI that cannot hold a session cookie. Interactive admins
# do not need it — a role="admin" session cookie is accepted instead. Write
# routes fail closed (HTTP 401) when neither credential is presented.
ADMIN_API_TOKEN=your_admin_api_token

# App Configuration
NEXT_PUBLIC_APP_NAME="OTT Platform"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
